# Production environment — set in Dokploy Environment panel or copy to .env
# NEVER commit the real .env file!

# --- Required ---
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_NAME=dahticket
DB_PORT=5432

JWT_SECRET=change-me-openssl-rand-base64-32
ADMIN_PASSWORD=change-me-strong-admin-password

# Set true once to reset admin password from ADMIN_PASSWORD, then set back to false
ADMIN_FORCE_PASSWORD=false

# --- Application ---
# PORT is fixed to 8080 inside compose (nginx proxies backend:8080). Do not change it.
JWT_EXPIRATION_HOURS=24

# Admin seed (only if no super admin exists yet)
ADMIN_EMAIL=admin@digidesks.cc

# Seed flags
SEED_DEMO_USERS=false
SEED_LOCATIONS=true

# Public site URL (used in email deep links)
FRONTEND_URL=https://your-domain.com

# SLA targets (hours)
SLA_LOW_HOURS=48
SLA_MEDIUM_HOURS=24
SLA_HIGH_HOURS=8
SLA_CRITICAL_HOURS=2

# Email (leave blank to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_ADDR=

# Frontend build — relative path; nginx proxies /api to backend
VITE_API_URL=/api

# Host port for Cloudflare Tunnel on the VPS (cloudflared → http://127.0.0.1:PORT)
FRONTEND_HOST_PORT=8088
