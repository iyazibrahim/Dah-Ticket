# DigiDesk Environment Configuration Template
#
# Copy to .env in the repo root for docker-compose
# NEVER commit the actual .env file to Git!

# Backend
PORT=8080

# PostgreSQL
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me-to-a-secure-password
DB_NAME=dahticket

# JWT — MUST CHANGE IN PRODUCTION
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-to-a-secure-random-string-32-chars-minimum
JWT_EXPIRATION_HOURS=24

# Admin seed (created only if no super admin exists)
ADMIN_EMAIL=admin@digidesks.cc
ADMIN_PASSWORD=admin123

# Seed flags
# Local: demo users on by default in compose; set false to skip
SEED_DEMO_USERS=true
SEED_LOCATIONS=true

# SLA (hours)
SLA_LOW_HOURS=48
SLA_MEDIUM_HOURS=24
SLA_HIGH_HOURS=8
SLA_CRITICAL_HOURS=2

# Email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_ADDR=

# Frontend API URL (use /api for Docker; Vite proxies /api in npm run dev)
VITE_API_URL=/api
